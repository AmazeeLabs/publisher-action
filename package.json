{
  "name": "publisher-action",
  "description": "Amazee Labs Publisher GitHub Action",
  "version": "0.0.0",
  "author": "Amazee Labs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": "20",
    "pnpm": "8.6.12"
  },
  "scripts": {
    "package": "rm -rf dist && pnpm exec ncc build src/main.ts -o dist/main && pnpm exec ncc build src/pre.ts -o dist/pre && pnpm exec ncc build src/post.ts -o dist/post",
    "check": "if [ -n \"$CI\" ]; then prettier --check .; else prettier --write --log-level warn .; fi && pnpm test:static && pnpm test",
    "test:static": "tsc --noEmit && eslint . --ext .ts --quiet",
    "test": "vitest run",
    "prepare": "husky || true"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@amazeelabs/publisher-shared": "^2.0.28",
    "@octokit/rest": "^21.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
